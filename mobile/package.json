{
  "name": "porcipeso-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "PorciPeso — app móvil Android (Capacitor): UI existente + backend embebido TS (engine/db/bluetooth) vía shim de fetch/WebSocket",
  "type": "module",
  "scripts": {
    "gen:profiles": "node scripts/gen_profiles.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run gen:profiles && vitest run",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^6.0.1",
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@e-is/capacitor-bluetooth-serial": "^6.0.3",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/sql.js": "^1.4.9",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
