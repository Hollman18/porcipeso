# =============================================================================
# PorciPeso Cloud — variables de entorno del servidor nube
# Copia este archivo como `.env` junto al docker-compose.yml y rellénalo.
# ¡El .env real contiene secretos!  chmod 600 .env  y JAMÁS al repo.
# =============================================================================

# OBLIGATORIA. Secreto HS256 con el que se firman los JWT. Sin ella el
# servidor NO arranca. Genera uno fuerte:  openssl rand -hex 32
CLOUD_JWT_SECRET=

# Bootstrap del PRIMER superadmin (idempotente: solo se crea si no existe
# ninguno; después estas dos variables se ignoran). Mínimo 10 caracteres
# de contraseña. Genera una:  openssl rand -base64 18
CLOUD_SUPERADMIN_EMAIL=admin@porcipeso.app
CLOUD_SUPERADMIN_PASSWORD=

# Ruta de la base SQLite DENTRO del contenedor. El default de la imagen ya
# apunta al volumen persistente; normalmente NO hay que tocarla.
#CLOUD_DB=/data/porcipeso_cloud.db

# Puerto HTTP de escucha dentro del contenedor (el mapeo al host lo define
# docker-compose.yml). Default: 8090.
#CLOUD_PORT=8090

# Imagen a usar por docker-compose. Default: la publicada por CI en ghcr.
# Si el pull anónimo falla (paquete privado), construye local y descomenta:
#PORCIPESO_CLOUD_IMAGE=porcipeso-cloud:local
